# Скопируй в .env и заполни. .env НЕ коммитить.

# --- GigaChat / GigaCode ---
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max

# --- Внешние системы (заполнить теми, что дадут на хакатоне) ---
SBERTRACK_BASE_URL=
SBERTRACK_TOKEN=

SONARQUBE_BASE_URL=
SONARQUBE_TOKEN=

GITLAB_BASE_URL=
GITLAB_TOKEN=

TMS_BASE_URL=
TMS_TOKEN=

# --- HTTP MCP server ---
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
