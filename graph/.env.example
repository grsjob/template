# Скопируй в graph/.env и заполни. graph/.env НЕ коммитить.

# --- LLM для извлечения сущностей/фактов (обязателен хотя бы один) ---
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# Другие провайдеры (опционально):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# VOYAGE_API_KEY=

# --- Параллелизм обработки эпизодов (см. тир твоего LLM-провайдера) ---
SEMAPHORE_LIMIT=5

# --- Телеметрия Graphiti ---
GRAPHITI_TELEMETRY_ENABLED=false

# --- FalkorDB (дефолт, менять не обязательно) ---
FALKORDB_URI=redis://falkordb:6379
